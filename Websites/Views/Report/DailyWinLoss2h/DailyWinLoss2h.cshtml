<body style="" id="pageBody">
    <div id="dailyWLReportDiv" style="padding-left: 3px;">
        <div class="main" style="width: 100%;">
            <table class="maincontent" style="width: 100%;" border="0" cellpadding="0px" cellspacing="0px">
                <tr style="width: 100%;">
                    <td>
                        <table border="0" cellpadding="0px" cellspacing="0px" class="maincontent_header">
                            <tr>
                                <td class="maincontent_headerL">
                                </td>
                                <td class="maincontent_headerC">
                                    Daily Win Loss (2h)
                                </td>
                                <td class="maincontent_headerR">
                                </td>
                            </tr>
                        </table>
                        <div class="maincontent_box" style="padding-right: 5px; width: 99%;">
                            @Html.Partial("Default/Report/DateTimeSinglePath_2h")
                        </div>
                        <div>
                            <div id="InformationMssg" style="display: none; word-wrap: break-word;">
                            </div>
                        </div>
                        <div id="trPath" style="padding: 3px 0px 3px 3px;">
                        </div>
                    </td>
                </tr>
                <tr>
                    <td>
                        <div id="mainreport" style="margin-top: 2px;">
                            @Html.Partial("~/Views/Report/DailyWinLoss2h/MainReport_DWL2h.cshtml")
                            @Html.Partial("~/Views/Report/DailyWinLoss2h/CombinationMixParlayReport.cshtml")
                            @Html.Partial("~/Views/Report/DailyWinLoss2h/AdvanceMixParlayReport.cshtml")
                            @Html.Partial("~/Views/Report/DailyWinLoss2h/MixParlayReport.cshtml")
                            @Html.Partial("~/Views/Report/DailyWinLoss2h/LiveCasinoReport.cshtml")
                            @Html.Partial("~/Views/Report/DailyWinLoss2h/SoccerReport.cshtml")
                            @Html.Partial("~/Views/Report/DailyWinLoss2h/HorseRacingReport.cshtml")
                            @Html.Partial("~/Views/Report/DailyWinLoss2h/NumberGameReport.cshtml")
                            @Html.Partial("~/Views/Report/DailyWinLoss2h/CasinoReport.cshtml")
                            @Html.Partial("~/Views/Report/DailyWinLoss2h/BingoReport.cshtml")
                            @Html.Partial("~/Views/Report/DailyWinLoss2h/OtherSportsReport.cshtml")
                            @Html.Partial("~/Views/Report/DailyWinLoss2h/FinanceReport.cshtml")
                            <iframe id="frm" width="0" height="0" frameborder="0" style="display: none"></iframe>
                        </div>
                    </td>
                </tr>
