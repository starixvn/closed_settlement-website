      <section name="Settlement" type="Sunplus.Accounting.Core.Configurations.StoreProcedureGroup.SettlementSession, Sunplus.Accounting.Core, Version=1.0.12.142, Culture=neutral"/>
      <section name="SportbookPt" type="Sunplus.Accounting.Core.Configurations.StoreProcedureGroup.SportbookPtSession, Sunplus.Accounting.Core, Version=1.0.0.0, Culture=neutral"/>
      <section name="ViewPt" type="Sunplus.Accounting.Core.Configurations.StoreProcedureGroup.ViewPtSession, Sunplus.Accounting.Core, Version=1.0.0.0, Culture=neutral"/>
      <section name="BetAggregator" type="Sunplus.Accounting.Core.Configurations.StoreProcedureGroup.BetAggregatorSection, Sunplus.Accounting.Core, Version=1.0.0.0, Culture=neutral"/>
      <section name="BetList" type="Sunplus.Accounting.Core.Configurations.StoreProcedureGroup.BetListSection, Sunplus.Accounting.Core, Version=1.0.0.0, Culture=neutral"/>
      <section name="UserControl" type="Sunplus.Accounting.Core.Configurations.StoreProcedureGroup.UserControlSession, Sunplus.Accounting.Core, Version=1.0.0.0, Culture=neutral"/>
      <section name="SpecialDelete" type="Sunplus.Accounting.Core.Configurations.StoreProcedureGroup.SpecialDeleteGroupSection, Sunplus.Accounting.Core, Version=1.0.0.0, Culture=neutral"/>
