    <!--Fanex-->
    <!--MVC-->
    <!--MVC-->

  </configSections>
  <!--MVC-->
  <!--MVC-->
  <!--Fanex-->
  <Fanex.Logging msmqPath="FormatName:DIRECT=TCP:10.18.200.202\private$\entlib" defaultCategory="Accounting"/>
  <Fanex.Data.DbSettingProvider default="XmlDbSettingProvider">
    <providers>
      <add name="XmlDbSettingProvider" type="Fanex.Data.Configuration.XmlDbSettingProvider, Fanex.Data" resourcePath="~/Configurations/StoreProcedureGroup/StoreProcedureName.xml" enableWatching="1"/>
    </providers>
  </Fanex.Data.DbSettingProvider>
  <couchbase>
    <servers bucket="Accounting" bucketPassword="">
      <add uri="http://10.18.200.202:8091/pools/default"/>
      <add uri="http://10.18.200.207:8091/pools/default"/>
      <add uri="http://10.18.200.210:8091/pools/default"/>
    </servers>
  </couchbase>
  <!--Fanex-->
  <memcached protocol="Binary">
    <servers>
      <add address="10.18.200.201" port="11211"/>
    </servers>
    <socketPool minPoolSize="1" maxPoolSize="10" connectionTimeout="00:00:03" deadTimeout="00:00:03"/>
  </memcached>

  <StoreProcedureGroup>
    <Helper configSource="Configurations\StoreProcedureGroup\Helper.config"/>
    <Admin configSource="Configurations\StoreProcedureGroup\Admin.config"/>
    <Casino configSource="Configurations\StoreProcedureGroup\Casino.config"/>
    <CreditTerm configSource="Configurations\StoreProcedureGroup\CreditTerm.config"/>
    <Customer configSource="Configurations\StoreProcedureGroup\Customer.config"/>
    <ExchangeRate configSource="Configurations\StoreProcedureGroup\ExchangeRate.config"/>
    <Racing configSource="Configurations\StoreProcedureGroup\Racing.config"/>
    <Report configSource="Configurations\StoreProcedureGroup\Report.config"/>
    <Settlement configSource="Configurations\StoreProcedureGroup\Settlement.config"/>
    <SportbookPt configSource="Configurations\StoreProcedureGroup\SportbookPt.config"/>
    <ViewPt configSource="Configurations\StoreProcedureGroup\ViewPt.config"/>
    <BetAggregator configSource="Configurations\StoreProcedureGroup\BetAggregator.config"/>
    <BetList configSource="Configurations\StoreProcedureGroup\BetList.config"/>
    <UserControl configSource="Configurations\StoreProcedureGroup\UserControl.config"/>
    <SpecialDelete configSource="Configurations\StoreProcedureGroup\SpecialDelete.config"/>
    <LogDisplay configSource="Configurations\StoreProcedureGroup\LogDisplay.config"/>
    <P2P configSource="Configurations\StoreProcedureGroup\P2P.config"/>
    <Transaction configSource="Configurations\StoreProcedureGroup\Transaction.config"/>
  </StoreProcedureGroup>

  <SportsSection configSource="Configurations\SportsSection.config"/>
  <MailSection configSource="Configurations\MailSection.config"/>

  <HelperSection configSource="Configurations\HelperSection.config"/>
  <UserControl configSource="Configurations\UserControlSection.config"/>
  <!--Bingo API-->
  <unity>
    <typeAliases>
      <!-- Lifetime manager types -->
      <typeAlias alias="singleton" type="Microsoft.Practices.Unity.ContainerControlledLifetimeManager, Microsoft.Practices.Unity"/>
      <typeAlias alias="external" type="Microsoft.Practices.Unity.ExternallyControlledLifetimeManager, Microsoft.Practices.Unity"/>
      <!-- Custom object types -->
      <typeAlias alias="ICustomerService" type="Sunplus.Bingo.Services.ICustomerService, Sunplus.Bingo.Services"/>
      <typeAlias alias="CustomerService" type="Sunplus.Bingo.Services.CustomerService, Sunplus.Bingo.Services"/>
      <typeAlias alias="IReportService" type="Sunplus.Bingo.Services.IReportService, Sunplus.Bingo.Services"/>
      <typeAlias alias="ReportService" type="Sunplus.Bingo.Services.ReportService, Sunplus.Bingo.Services"/>
      <typeAlias alias="ICustomerDAO" type="Sunplus.Bingo.Data.ICustomerDAO, Sunplus.Bingo.Data"/>
      <typeAlias alias="IReportDAO" type="Sunplus.Bingo.Data.IReportDAO, Sunplus.Bingo.Data"/>
      <typeAlias alias="ILogger" type="Sunplus.Core.LoggingLib.ILogger, Sunplus.Core.LoggingLib"/>
      <typeAlias alias="LinqCustomerDAO" type="Sunplus.Bingo.Data.LinqToSql.LinqCustomerDAO, Sunplus.Bingo.Data.LinqToSql"/>
      <typeAlias alias="LinqReportDAO" type="Sunplus.Bingo.Data.LinqToSql.LinqReportDAO, Sunplus.Bingo.Data.LinqToSql"/>
      <typeAlias alias="EntLibLogger" type="Sunplus.Core.LoggingLib.EntLibLogger, Sunplus.Core.LoggingLib"/>
    </typeAliases>
    <containers>
      <container name="BingoContainer">
        <types>
          <type type="ICustomerService" mapTo="CustomerService"/>
          <type type="IReportService" mapTo="ReportService"/>
          <type type="ICustomerDAO" mapTo="LinqCustomerDAO"/>
          <type type="IReportDAO" mapTo="LinqReportDAO"/>
          <type type="ILogger" mapTo="EntLibLogger"/>
        </types>
      </container>
    </containers>
  </unity>
  <!--Eng Bingo API-->
  <!--SSL-->
  <!--<secureWebPages mode="RemoteOnly" ignoreHandlers="WithStandardExtensions" xmlns="http://Ventaur/WebPageSecurity.v3x.xsd">
    <files>
      <add path="SignIn.aspx"/>
    </files> 
    <directories>
    </directories>
  </secureWebPages>-->
  <!--End SSL-->
  <IBCAccounting>
    <Casino providerType="Sunplus.Accounting.DataAccess.APIClient.APICasinoProvider" showBetSetting="false"/>
    <IBCCustomer providerType="Sunplus.Accounting.DataAccess.APIClient.IBCLibProvider"/>
    <PositionTaking providerType="Sunplus.Accounting.DataAccess.IBCClient.PositionTakingProviderClient" providerTypeHR="Sunplus.Accounting.DataAccess.IBCClient.HRPositionTakingProviderClient"/>
  </IBCAccounting>
  <indexusNetSharedCache defaultProvider="IndexusSharedCacheProvider">
    <clientSetting SharedCacheVersionNumber="3.0.5.1" LoggingEnable="1" CompressionEnabled="1" CompressionMinSize="1024000" SocketPoolMinAvailableSize="5" HashingAlgorithm="Hashing"/>
    <!-- 
      Hashing (default - is useless if your envrionment is using different versions of CLR's) 
      Ketama 
      FvnHash32
      FvnHash64
      -->
    <servers>
      <add key="Srv201" ipaddress="10.18.200.201" port="48888"/>
    </servers>
    <replicatedServers>
      <!-- only use this node in case you are using replication mode on server -->
      <!--<add key="SrvZh02"    ipaddress="192.168.212.37" port="48888" />-->
    </replicatedServers>
    <providers>
      <add name="IndexusSharedCacheProvider" type="SharedCache.WinServiceCommon.Provider.Cache.IndexusSharedCacheProvider, SharedCache.WinServiceCommon"/>
    </providers>
  </indexusNetSharedCache>
  <nlog autoReload="true" throwExceptions="true">
    <targets async="true">
      <target name="shared_cache_general" type="File" layout="${longdate}|${level:uppercase=true}|${aspnet-request:item=logSession}|${message}" filename="C:\temp\logs\client\${date:format=yyyy-MM-dd}_shared_cache_general_log.txt"/>
      <target name="shared_cache_traffic" type="File" layout="${longdate}|${level:uppercase=true}|${aspnet-request:item=logSession}|${message}" filename="C:\temp\logs\client\${date:format=yyyy-MM-dd}_shared_cache_traffic_log.txt"/>
      <target name="shared_cache_tracking" type="File" layout="${longdate}|${level:uppercase=true}|${aspnet-request:item=logSession}|${message}" filename="C:\temp\logs\client\${date:format=yyyy-MM-dd}_shared_cache_tracking_log.txt"/>
      <target name="shared_cache_sync" type="File" layout="${longdate}|${level:uppercase=true}|${aspnet-request:item=logSession}|${message}" filename="C:\temp\logs\client\${date:format=yyyy-MM-dd}_shared_cache_sync_log.txt"/>
    </targets>
    <rules>
      <logger name="General" minlevel="Debug" writeTo="shared_cache_general" final="true"/>
      <logger name="Traffic" minlevel="Debug" writeTo="shared_cache_traffic" final="true"/>
      <logger name="Tracking" minlevel="Debug" writeTo="shared_cache_tracking" final="true"/>
      <logger name="Sync" minlevel="Debug" writeTo="shared_cache_sync" final="true"/>
      <logger name="*" minlevel="Debug" writeTo="shared_cache_general"/>
      <logger name="*" minlevel="Info" writeTo="shared_cache_general"/>
    </rules>
  </nlog>
  <!--<cachingConfiguration defaultCacheManager="Cache Manager">
    -<cacheManagers>
      <add expirationPollFrequencyInSeconds="1000" maximumElementsInCacheBeforeScavenging="0" numberToRemoveWhenScavenging="10" backingStoreName="Null Storage" name="Cache Manager"/>
    </cacheManagers>
    <backingStores>  
      <add encryptionProviderName="" type="Microsoft.Practices.EnterpriseLibrary.Caching.BackingStoreImplementations.NullBackingStore, Microsoft.Practices.EnterpriseLibrary.Caching, Version=5.0.414.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" name="Null Storage"/>
    </backingStores>
  </cachingConfiguration>-->
  <cachingConfiguration defaultCacheManager="Cache Manager">
    <cacheManagers>
      <add name="Cache Manager" type="Microsoft.Practices.EnterpriseLibrary.Caching.CacheManager, Microsoft.Practices.EnterpriseLibrary.Caching, Version=5.0.414.0" expirationPollFrequencyInSeconds="1000" maximumElementsInCacheBeforeScavenging="500" numberToRemoveWhenScavenging="10" backingStoreName="Null Storage"/>
    </cacheManagers>
    <backingStores>
      <add encryptionProviderName="" type="Microsoft.Practices.EnterpriseLibrary.Caching.BackingStoreImplementations.NullBackingStore, Microsoft.Practices.EnterpriseLibrary.Caching, Version=5.0.414.0" name="Null Storage"/>
    </backingStores>
  </cachingConfiguration>
  <!--entlib configuration-->
  <dataConfiguration defaultDatabase="DBLogConnectionString"/>
  <!--/entlib configuration-->
  <log4net>
    <appender name="ConsoleAppender" type="log4net.Appender.ConsoleAppender">
      <layout type="log4net.Layout.PatternLayout">
        <param name="ConversionPattern" value="%d [%t] %-5p %c [%x] &lt;%X{auth}&gt; - %m%n"/>
      </layout>
    </appender>
    <appender name="GeneralLog" type="log4net.Appender.RollingFileAppender">
      <file value="LogCS/CasinoLibrary.txt"/>
      <appendToFile value="true"/>
      <maximumFileSize value="100MB"/>
      <rollingStyle value="Date"/>
      <maxSizeRollBackups value="5"/>
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%d{HH:mm:ss.fff} [%t] %-5p %c - %m%n"/>
      </layout>
    </appender>
    <!-- levels: DEBUG, INFO, WARN, ERROR, FATAL -->
    <root>
      <level value="DEBUG"/>
      <appender-ref ref="ConsoleAppender"/>
      <appender-ref ref="GeneralLog"/>
    </root>
  </log4net>
  <appSettings file="Web_AppSettings.config">
    <!--MVC-->
    <add key="webpages:Version" value="2.0.0.0"/>
    <add key="ClientValidationEnabled" value="true"/>
    <add key="UnobtrusiveJavaScriptEnabled" value="true"/>
    <add key="PreserveLoginUrl" value="true"/>
    <add value="false" key="autoFormsAuthentication"/>
    <!--MVC-->
    <add key="loginfailed_countdown_minute" value="5"/>
    <add key="NumberWrongPassword" value="6"/>
    <add key="IPService.geoipservice" value="http://www.webservicex.net/geoipservice.asmx"/>
    <!--ViewLog-->
    <!--This key indicated refresh cache xslt transform object. It is neccessary for upload new xslt file-->
    <!--/ViewLog-->
    <add key="whatnews_upload_dir" value="../../Others/ReleaseLog/images/upload/"/>
    <add key="whatnews_upload_url" value="../../Others/ReleaseLog/images/upload/{0}"/>
    <add key="UM" value="0"/>
    <add key="cached" value="true"/>
    <add key="app_mail_id" value="1"/>
    <!--<add key="app_mail_address" value="net.tcp://10.19.10.61:8585/MailService"/>-->
    <add key="app_mail_address" value="net.tcp://10.18.200.201:8585/MailService"/>
  </appSettings>
  <connectionStrings configSource="Configurations\ConnectionStrings.config"/>
  <system.web>
    <siteMap defaultProvider="SystemFunctions">
      <providers>
        <add name="SystemFunctions" type="System.Web.XmlSiteMapProvider" siteMapFile="~/App_Data/System.sitemap"/>
      </providers>
    </siteMap>
    <!--<httpHandlers>
      <add path="*.htm" verb="*" type="System.Web.StaticFileHandler"/>
    </httpHandlers>-->
    <customErrors mode="Off" defaultRedirect="~/ErrorPage.aspx"/>
    <compilation debug="true" targetFramework="4.0">
      <assemblies>
        <add assembly="System.Management, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B03F5F7F11D50A3A"/>
        <add assembly="System.Configuration.Install, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B03F5F7F11D50A3A"/>
        <add assembly="System.Messaging, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B03F5F7F11D50A3A"/>
        <add assembly="System.Data.OracleClient, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B77A5C561934E089"/>
        <add assembly="System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B77A5C561934E089"/>
        <add assembly="System.Runtime.Remoting, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B77A5C561934E089"/>
        <add assembly="Microsoft.VisualBasic, Version=10.0.0.0, Culture=neutral, PublicKeyToken=B03F5F7F11D50A3A"/>
        <add assembly="System.Data.Linq, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B77A5C561934E089"/>
        <add assembly="System.Data.Entity, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B77A5C561934E089"/>
        <add assembly="System.Data.Services, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B77A5C561934E089"/>
        <add assembly="System.Data.Services.Client, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B77A5C561934E089"/>
        <!--MVC-->
        <add assembly="System.Web.Abstractions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35"/>
        <add assembly="System.Web.Helpers, Version=2.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35"/>
        <add assembly="System.Web.Routing, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35"/>
        <add assembly="System.Web.Mvc, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35"/>
        <add assembly="System.Web.WebPages, Version=2.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35"/>

        <add assembly="System.Web.Razor, Version=2.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35"/>
        <add assembly="Microsoft.Web.Infrastructure, Version=1.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35"/>
        <!--MVC-->
      </assemblies>
      <buildProviders/>
    </compilation>
    <authentication mode="Forms">
      <forms loginUrl="~/SignIn.aspx" cookieless="UseCookies" defaultUrl="index.aspx" name="AccLoginForm" protection="All"/>
    </authentication>
    <!--<authorization>
      <deny users="?"/>
    </authorization>-->
    <sessionState mode="StateServer" timeout="10"/>
    <globalization requestEncoding="utf-8" responseEncoding="utf-8"/>
    <httpRuntime maxRequestLength="102400" executionTimeout="180"/>
    <!--MVC-->
    <pages validateRequest="false" controlRenderingCompatibilityVersion="3.5" clientIDMode="AutoID">
      <namespaces>
        <add namespace="System.Web.Helpers"/>
        <add namespace="System.Web.Mvc"/>
        <add namespace="System.Web.Mvc.Ajax"/>
        <add namespace="System.Web.Mvc.Html"/>
        <add namespace="System.Web.Routing"/>
        <add namespace="System.Web.WebPages"/>
        <add namespace="Fanex.Tarus.Web.Models"/>
      </namespaces>
    </pages>
    <!--MVC-->
    <httpModules/>
    <!--Mechine key for single sign on to CRM-->
    <machineKey validationKey="82DD5F7E8AEE17163191F82D6E74F88716B3A834BD6D1DC5F32CB2F613222E36144B019843C69D711C8EE551F341FDFD60B1AB77F943B02A00467A0D2D632EEB" decryptionKey="436E102A02B3582E206F1111DC137F5F2BFC57EBFB8ECD6736596ABDA63B9A65" validation="SHA1" decryption="AES"/>
  </system.web>
  <!--MVC-->
  <location path="SignIn.aspx">
    <system.web>
      <authorization>
        <allow users="*"/>
      </authorization>
    </system.web>
  </location>
  <!--MVC-->
  <location path="UnderMaintenance.aspx">
    <system.web>
      <authorization>
        <allow users="*"/>
      </authorization>
    </system.web>
  </location>
  <location path="App_Themes">
    <system.web>
      <authorization>
        <allow users="*"/>
      </authorization>
    </system.web>
  </location>
  <location path="PreLogIn">
    <system.web>
      <authorization>
        <allow users="*"/>
      </authorization>
    </system.web>
  </location>
  <system.webServer>
    <validation validateIntegratedModeConfiguration="false"/>
    <modules runAllManagedModulesForAllRequests="true"/>
  </system.webServer>
  <!--WCF Service-->
  <system.serviceModel>
    <behaviors configSource="Configurations\Wcf\Behaviors.config"/>
    <serviceHostingEnvironment aspNetCompatibilityEnabled="true" multipleSiteBindingsEnabled="true"/>
    <services configSource="Configurations\Wcf\Services.config"/>
    <bindings configSource="Configurations\Wcf\Bindings.config"/>
    <client configSource="Configurations\Wcf\Clients.config"/>
  </system.serviceModel>
</configuration>
