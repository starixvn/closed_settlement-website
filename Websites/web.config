      <section name="Casino" type="Sunplus.Accounting.Core.Configurations.StoreProcedureGroup.CasinoSession, Sunplus.Accounting.Core, Version=1.0.0.0, Culture=neutral"/>
      <section name="CreditTerm" type="Sunplus.Accounting.Core.Configurations.StoreProcedureGroup.CreditTermSession, Sunplus.Accounting.Core, Version=1.0.0.0, Culture=neutral"/>
      <section name="Customer" type="Sunplus.Accounting.Core.Configurations.StoreProcedureGroup.CustomerSession, Sunplus.Accounting.Core, Version=1.0.0.0, Culture=neutral"/>
      <section name="ExchangeRate" type="Sunplus.Accounting.Core.Configurations.StoreProcedureGroup.ExchangeRateSession, Sunplus.Accounting.Core, Version=1.0.0.0, Culture=neutral"/>
