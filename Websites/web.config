    <!--End Store Procedure-->
    <!--Mail-->
    <section name="MailSection" type="Sunplus.Accounting.Core.Configurations.MailSection, Sunplus.Accounting.Core, Version=1.0.0.0, Culture=neutral"/>
    <!--End Mail-->
    <section name="SportsSection" type="Sunplus.Accounting.Core.Configurations.SportsSection, Sunplus.Accounting.Core, Version=1.0.0.0, Culture=neutral"/>

